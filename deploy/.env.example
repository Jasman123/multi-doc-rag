# Copy to deploy/.env and fill in. deploy/.env is gitignored — never commit it.

# Your domain, e.g. rag.example.com (DNS A record must point at the server IP)
DOMAIN=

# Use hex so the value is safe inside the DATABASE_URL:  openssl rand -hex 24
POSTGRES_PASSWORD=

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Fernet key protecting provider API keys stored in Postgres. BACK THIS UP off-server;
# losing it makes every stored provider key unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
