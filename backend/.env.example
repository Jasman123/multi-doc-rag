# Optional — defaults shown
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION_NAME=multi_doc_rag
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_FINAL=8
RAG_MAX_RETRIES=1
GRADE_SKIP_SIMILARITY=0.55

DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/multi_doc_rag_auth
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ENCRYPTION_KEY: Fernet key protecting provider API keys stored in Postgres
# (set via the admin UI, see /admin.html). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme-generate-with-python-fernet-generate-key
